# ==========================================================================
# NEXUSFLOW - PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================================

PORT=8081
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL="postgresql://nexus_user:secure_password_2026@localhost:5432/nexusflow_db?schema=public"

# Redis Cache & PubSub
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_SECRET="super_secret_jwt_key_nexusflow_prod_2026_x89a"
JWT_EXPIRES_IN="24h"

# Meta WhatsApp Cloud API
META_APP_ID="123456789012345"
META_APP_SECRET="nexusflow_secret_key_2026"
META_WEBHOOK_VERIFY_TOKEN="nexusflow_token_123"
WHATSAPP_PHONE_NUMBER_ID="987654321098765"
WHATSAPP_ACCESS_TOKEN="EAAG..."

# Manus AI Copilot API
MANUS_API_KEY="manus_live_key_998877665544332211"
MANUS_API_ENDPOINT="https://api.manus.ai/v1/agent"

# Object Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER="r2"
S3_BUCKET_NAME="nexusflow-media-storage"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="r2_access_key"
S3_SECRET_ACCESS_KEY="r2_secret_key"
